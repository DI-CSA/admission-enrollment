{
  "name": "plataforma",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "env:homolog": "ln -sf .env.homolog .env.local && echo '→ .env.local = HOMOLOGAÇÃO (escrita liberada, master-key ativa)'",
    "env:prod": "ln -sf .env.prod .env.local && echo '→ .env.local = PRODUÇÃO (somente leitura, sem master-key)'",
    "env:which": "readlink .env.local && echo '(perfil ativo)' || echo '.env.local é arquivo comum (não é symlink de perfil)'",
    "dev:homolog": "pnpm env:homolog && next dev",
    "dev:prod": "pnpm env:prod && next dev",
    "visitas:migrate": "node --env-file=.env.local scripts/visitas-migrate.mjs",
    "rm:discovery": "node --env-file=.env.local scripts/rm-discovery.mjs",
    "totvs:probe": "node --env-file=.env.local scripts/totvs-sql-probe.mjs",
    "totvs:ps": "node --env-file=.env.local scripts/totvs-ps-list.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "mssql": "^12",
    "next": "16.2.9",
    "nodemailer": "^6.10.1",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mssql": "^12.3.0",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
